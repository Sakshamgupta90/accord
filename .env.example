# ─────────────────────────────────────────────────────────────────────────────
# Accord — environment template. Placeholders only: never commit a real value.
#
#   cp .env.example .env
#
# Every factory validates only the configuration it needs and fails clearly when
# a live credential is missing. There is no fallback from a live provider to a
# test double, and no production "mock" mode: tests inject adapters directly.
# Owner of this file: Agent 1. Request additions through Agent 1.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
# demo | live. Controls demo-only affordances, never provider substitution.
ACCORD_MODE=demo
PORT=3000

# ── Model · OpenAI Responses API ─────────────────────────────────────────────
# ACCORD_MODEL is the Accord model id; it must be tested against your account.
ACCORD_MODEL_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=
ACCORD_MODEL=gemini-3.1-flash-lite
# Optional: minimal | low | medium | high. `low` keeps Slack replies fast.
ACCORD_MODEL_REASONING_EFFORT=low

# The imported starter (apps/channel, apps/web, packages/agent-core) reads these
# names for its own model resolution. Keep them consistent with ACCORD_MODEL.
MODEL_PROVIDER=google
MODEL=gemini-3.1-flash-lite

# ── CopilotKit Channels · direct Slack adapter + Intelligence ────────────────
INTELLIGENCE_API_KEY=
CHANNEL_CODE=
LOG_LEVEL=debug
# Self-hosted Intelligence only. Override BOTH or NEITHER, as bare base URLs.
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=

# ── Slack · one app identity; the same bot posts background findings ────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
ACCORD_SLACK_TEAM_ID=
ACCORD_SLACK_CHANNEL_ID=
# The single configured decision owner. A message claiming to be the owner is
# not identity evidence; only this transport-authenticated user can confirm.
ACCORD_OWNER_SLACK_USER_ID=
# Our own bot user id, resolved through authenticated Slack setup (auth.test), never guessed and
# never supplied by a model. Ingress uses it so Accord's own findings cannot re-trigger an
# investigation, and the publisher requires it. Added by Agent 1 beyond the packet's required list.
ACCORD_BOT_USER_ID=

# ── GitHub · one allowed repository and one allowed path prefix ─────────────
GITHUB_TOKEN=
ACCORD_GITHUB_OWNER=
ACCORD_GITHUB_REPO=
ACCORD_REPO_REF=main
ACCORD_REPO_PATH_PREFIX=fixtures/retention-app/

# ── PostgreSQL · durable authority ──────────────────────────────────────────
DATABASE_URL=
# Optional: a throwaway database for `npm run test:integration`. These tests create and drop their
# own schema. Never point them at anything you care about.
# ACCORD_TEST_DATABASE_URL=

# ── ClickHouse · restricted read-only runtime role ──────────────────────────
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# ── Trigger.dev · durable orchestration ─────────────────────────────────────
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# ── Dataset ─────────────────────────────────────────────────────────────────
# Immutable. Changing the fixture data means seeding a new version, verifying
# it, updating this value and restarting the bridge and workers explicitly.
ACCORD_DATASET_VERSION=

# ── Demo only ───────────────────────────────────────────────────────────────
# Fixed demo clock. Never used as wall time inside evaluation.
ACCORD_DEMO_AS_OF=2026-09-12T00:00:00.000Z
ACCORD_TRUSTED_PROFILE_PATH=
# Version of the trusted verification profile the repository investigator reports. Defaults to 1.0.
ACCORD_TRUSTED_PROFILE_VERSION=1.0
ACCORD_DEMO_RESET_ENABLED=false

# Admin seed credentials belong only to explicit seed commands and must never
# appear in the bridge or worker runtime environment.
# ACCORD_CLICKHOUSE_ADMIN_USER=
# ACCORD_CLICKHOUSE_ADMIN_PASSWORD=

# ── Inherited starter examples · not Accord features ────────────────────────
# apps/web and apps/mobile ship with the starter and stay unused by Accord.
# Auth0 and Exa are not required for v1; do not claim their integration.
# OPENROUTER_API_KEY=
# EXA_API_KEY=
# AMBIGUOUS_API_KEY=
