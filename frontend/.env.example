# Contact form (server-only). Copy to .env.local and fill in; never commit real values.
# Get a key at https://resend.com/api-keys (free tier).
RESEND_API_KEY=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=
# Optional: a sender on a domain you verified in Resend. Without it, Resend's shared test sender
# is used, which can only deliver to the email address you signed up to Resend with.
CONTACT_FROM_EMAIL=

# Sign-in (Auth.js). Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=
# Google (Gmail accounts): Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: http://localhost:3001/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Live Metrics traces from the Accord bridge (same token as ACCORD_TRACE_TOKEN in the root .env).
ACCORD_TRACE_URL=http://localhost:3000
ACCORD_TRACE_TOKEN=
